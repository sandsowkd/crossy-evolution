{
  "name": "crossy-evolution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsx scripts/data/build-site.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "tsx --test src/tests/*.test.ts",
    "benchmark": "tsx scripts/evaluation/benchmark.ts",
    "train": "tsx scripts/training/train.ts",
    "evaluate": "tsx scripts/evaluation/evaluate.ts",
    "demo": "tsx scripts/data/demo.ts",
    "bundle-demo": "tsx scripts/data/bundle-demo.ts",
    "verify:visuals": "tsx scripts/evaluation/verify-visuals.ts",
    "setup:assets": "tsx scripts/setup-assets.ts",
    "train:long": "tsx scripts/training/train-long.ts",
    "evaluate:long": "tsx scripts/evaluation/evaluate-long.ts",
    "bundle:learned": "tsx scripts/data/bundle-learned.ts",
    "check:seo": "tsx scripts/data/check-seo.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
